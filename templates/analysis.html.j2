<!DOCTYPE html>
<html lang="ko" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ full_name }} - 분석 결과</title>
  <style>
    :root {
      --bg: #f6f8fa; --surface: #ffffff; --border: #d0d7de;
      --text: #1f2328; --text-muted: #656d76; --text-link: #0969da;
      --accent: #2da44e; --code-bg: #f6f8fa; --code-border: #d0d7de;
      --tab-active: #fd8c73;
    }
    [data-theme="dark"] {
      --bg: #0d1117; --surface: #161b22; --border: #30363d;
      --text: #e6edf3; --text-muted: #7d8590; --text-link: #58a6ff;
      --accent: #3fb950; --code-bg: #161b22; --code-border: #30363d;
      --tab-active: #f78166;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
           background: var(--bg); color: var(--text); font-size: 14px; line-height: 1.6; }

    .page-header { background: var(--surface); border-bottom: 1px solid var(--border);
                   padding: 16px 24px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .back-link { color: var(--text-muted); text-decoration: none; font-size: 13px; }
    .back-link:hover { color: var(--text-link); }
    .repo-title { font-size: 18px; font-weight: 700; }
    .repo-title a { color: var(--text-link); text-decoration: none; }
    .repo-title a:hover { text-decoration: underline; }
    .repo-meta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 6px; }
    .badge { padding: 2px 10px; border-radius: 12px; font-size: 12px; font-weight: 600; }
    .badge-period { background: #ddf4ff; color: #0550ae; }
    [data-theme="dark"] .badge-period { background: #1f2d3d; color: #79c0ff; }
    .badge-lang { background: #f6f8fa; color: var(--text-muted); border: 1px solid var(--border); }
    .badge-stars { background: #fff3cd; color: #9a6700; }
    [data-theme="dark"] .badge-stars { background: #3d2c00; color: #e3b341; }
    .header-right { margin-left: auto; }
    .btn-theme { background: transparent; border: 1px solid var(--border); color: var(--text);
                 padding: 5px 10px; border-radius: 6px; cursor: pointer; font-size: 13px; }

    /* Tabs */
    .tabs { display: flex; border-bottom: 1px solid var(--border);
            background: var(--surface); padding: 0 24px; }
    .tab { padding: 10px 16px; cursor: pointer; border: none; border-bottom: 2px solid transparent;
           background: transparent; color: var(--text-muted); font-size: 14px; font-weight: 500; }
    .tab:hover { color: var(--text); }
    .tab.active { color: var(--text); border-bottom-color: var(--tab-active); }

    /* Content */
    .content { max-width: 960px; margin: 0 auto; padding: 24px; }
    .panel { display: none; }
    .panel.active { display: block; }

    /* Markdown styles */
    .md-body h1 { font-size: 1.6em; margin: 24px 0 12px; padding-bottom: 8px; border-bottom: 1px solid var(--border); }
    .md-body h2 { font-size: 1.3em; margin: 20px 0 10px; padding-bottom: 6px; border-bottom: 1px solid var(--border); }
    .md-body h3 { font-size: 1.1em; margin: 16px 0 8px; }
    .md-body h4 { font-size: 1em; margin: 12px 0 6px; }
    .md-body p { margin: 10px 0; }
    .md-body ul, .md-body ol { margin: 8px 0 8px 24px; }
    .md-body li { margin: 4px 0; }
    .md-body table { border-collapse: collapse; width: 100%; margin: 12px 0; font-size: 13px; }
    .md-body th, .md-body td { border: 1px solid var(--border); padding: 8px 12px; text-align: left; }
    .md-body th { background: var(--bg); font-weight: 600; }
    .md-body code { background: var(--code-bg); border: 1px solid var(--code-border);
                    border-radius: 4px; padding: 1px 5px; font-family: 'SFMono-Regular', Consolas, monospace;
                    font-size: 12px; }
    .md-body pre { background: var(--code-bg); border: 1px solid var(--code-border);
                   border-radius: 6px; padding: 14px; overflow-x: auto; margin: 12px 0; }
    .md-body pre code { background: none; border: none; padding: 0; font-size: 13px; }
    .md-body blockquote { border-left: 3px solid var(--border); padding-left: 12px;
                           color: var(--text-muted); margin: 12px 0; }
    .md-body a { color: var(--text-link); }
    .md-body a:hover { text-decoration: underline; }
    .md-body hr { border: none; border-top: 1px solid var(--border); margin: 16px 0; }

    .empty-notice { color: var(--text-muted); padding: 40px 0; text-align: center; font-size: 15px; }

    .footer { text-align: center; padding: 20px; color: var(--text-muted); font-size: 12px;
              border-top: 1px solid var(--border); margin-top: 24px; }
  </style>
</head>
<body>

<div class="page-header">
  <div style="flex:1; min-width:0;">
    <div style="margin-bottom:4px;">
      <a class="back-link" href="../index.html">← 대시보드로 돌아가기</a>
    </div>
    <div class="repo-title">
      <a href="https://github.com/{{ full_name }}" target="_blank" rel="noopener">{{ full_name }}</a>
    </div>
    {% if description %}
    <div style="color:var(--text-muted); margin-top:4px; font-size:13px;">{{ description }}</div>
    {% endif %}
    <div class="repo-meta">
      {% if period %}<span class="badge badge-period">{{ period }} trending</span>{% endif %}
      {% if language %}<span class="badge badge-lang">{{ language }}</span>{% endif %}
      {% if stars %}<span class="badge badge-stars">★ {{ stars }}</span>{% endif %}
      {% if stars_gained %}<span class="badge badge-stars">+{{ stars_gained }}</span>{% endif %}
    </div>
  </div>
  <div class="header-right">
    <button class="btn-theme" id="themeToggle">🌙</button>
  </div>
</div>

<div class="tabs">
  <button class="tab active" data-panel="analysis">📊 소스 분석</button>
  <button class="tab" data-panel="indepth">🔬 심층 분석</button>
  <button class="tab" data-panel="guide">📚 주니어 가이드</button>
</div>

<div class="content">
  <div class="panel active" id="panel-analysis">
    {% if analysis_html %}
    <div class="md-body">{{ analysis_html }}</div>
    {% else %}
    <div class="empty-notice">소스 분석 결과가 없습니다.</div>
    {% endif %}
  </div>

  <div class="panel" id="panel-indepth">
    {% if indepth_html %}
    <div class="md-body">{{ indepth_html }}</div>
    {% else %}
    <div class="empty-notice">심층 분석 결과가 없습니다.</div>
    {% endif %}
  </div>

  <div class="panel" id="panel-guide">
    {% if guide_html %}
    <div class="md-body">{{ guide_html }}</div>
    {% else %}
    <div class="empty-notice">주니어 가이드가 없습니다.</div>
    {% endif %}
  </div>
</div>

<footer class="footer">
  분석 대상: <strong>{{ full_name }}</strong> &nbsp;·&nbsp;
  GitHub Stars Dashboard &nbsp;·&nbsp;
  <a href="https://github.com/{{ full_name }}" target="_blank" rel="noopener">원본 저장소 →</a>
</footer>

<script>
// Tab switching
document.querySelectorAll('.tab').forEach(function(btn) {
  btn.addEventListener('click', function() {
    document.querySelectorAll('.tab').forEach(function(b){ b.classList.remove('active'); });
    document.querySelectorAll('.panel').forEach(function(p){ p.classList.remove('active'); });
    btn.classList.add('active');
    document.getElementById('panel-' + btn.dataset.panel).classList.add('active');
  });
});

// Dark mode
document.getElementById('themeToggle').addEventListener('click', function() {
  const html = document.documentElement;
  const isDark = html.getAttribute('data-theme') === 'dark';
  html.setAttribute('data-theme', isDark ? 'light' : 'dark');
  this.textContent = isDark ? '🌙' : '☀️';
  localStorage.setItem('theme', isDark ? 'light' : 'dark');
});
(function() {
  const saved = localStorage.getItem('theme') || 'light';
  document.documentElement.setAttribute('data-theme', saved);
  document.getElementById('themeToggle').textContent = saved === 'dark' ? '☀️' : '🌙';
})();
</script>
</body>
</html>
