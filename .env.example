# GitHub Stars Dashboard — environment variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# GitHub and Claude auth are managed via CLI sessions (not stored here):
#   GitHub : gh auth login
#   Claude : claude login

CLAUDE_MODEL=claude-sonnet-4-6
SOURCE_ACCOUNT=your-github-account-A
DEPLOY_ACCOUNT=your-github-account-B
DEPLOY_REPO=your-pages-repo-name
SCHEDULE_TIME=02:00
GIT_USER_NAME=dashboard-bot
GIT_USER_EMAIL=dashboard-bot@users.noreply.github.com
# Parallel Claude analysis: number of repos processed concurrently (peak claude
# processes ≈ value × number of scope skills). Default: 3.
ANALYSIS_CONCURRENCY=3
# Which skills run: comma list of source,indepth,guide — or "all". The --scope
# flag on run_claude_analysis.sh overrides this. Default: source (baseline tab;
# indepth/guide trip the usage limit more often, so they're opt-in).
ANALYSIS_SCOPE=source
